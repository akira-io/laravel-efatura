{
    "name": "akira/efatura",
    "description": "Fiscal compliance engine for Cabo Verde e-Fatura (DNRE) focused on XML, IUD, and middleware communication.",
    "license": "MIT",
    "authors": [
        {
            "name": "kid",
            "email": "kidiatoliny@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0",
        "spatie/laravel-data": "^4.19",
        "brick/money": "^0.11.0"
    },
    "require-dev": {
        "akira/laravel-debugger": "^1.3",
        "akira/setup": "^1.5",
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.2",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.3",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Akira\\Efatura\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akira\\Efatura\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
